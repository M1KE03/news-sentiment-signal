# Data is regenerated by `python run_all.py`, and the news dump is large and
# redistribution-restricted. Only the download script and the .gitkeep files
# are tracked.
data/raw/*
!data/raw/.gitkeep
!data/raw/download.py
!data/raw/README.md
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Figures are committed: the README shows the headline one.
!figures/

.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.ruff_cache/
.mypy_cache/

# Model and dataset caches
.cache/
hf_cache/

.DS_Store
Thumbs.db
.env
.vscode/
.idea/
